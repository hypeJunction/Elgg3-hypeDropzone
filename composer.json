{
    "name": "hypejunction/hypedropzone",
    "type": "elgg-plugin",
    "description": "Drag-n-drop file uploads for Elgg",
    "homepage": "https://github.com/hypeJunction/Elgg3-hypeDropzone",
    "keywords": [
        "elgg",
        "plugin",
        "upload",
        "dropzone",
        "drag-n-drop"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "composer/installers": "^2.0",
        "elgg/elgg": "~7.0.0"
    },
    "autoload": {
        "psr-4": {
            "hypeJunction\\": "classes/hypeJunction/"
        }
    },
    "extra": {
        "elgg-plugin": {
            "id": "hypedropzone"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
